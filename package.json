{
  "name": "@allegro/codemirror-lang-opel",
  "version": "0.1.0-beta.1",
  "description": "OPEL language support for CodeMirror",
  "keywords": [
    "codemirror",
    "opel",
    "language",
    "highlight",
    "autocomplete"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/allegro/codemirror-lang-opel"
  },
  "homepage": "https://github.com/allegro/codemirror-lang-opel",
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "generate-parser": "mkdir -p src/generated && lezer-generator src/grammar/opel.grammar --typeScript -o src/generated/parser",
    "generate-parser-debug": "mkdir -p src/generated && lezer-generator src/grammar/opel.grammar --names --typeScript -o src/generated/parser",
    "generate-parser:watch": "chokidar src/grammar/opel.grammar -c \"npm run generate-parser\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "dev": "npm run generate-parser && concurrently --names storybook,watcher \"npm run storybook\" \"npm run generate-parser:watch\"",
    "build": "npm run generate-parser && npm run typecheck && rollup -c",
    "build-debug": "npm run generate-parser-debug && npm run typecheck && rollup -c",
    "prepare": "npm run build"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.4.10"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/generator": "^1.8.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/html-vite": "^10.4.6",
    "@types/node": "^24.1.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.3",
    "prettier": "^3.8.4",
    "rollup": "^4.62.2",
    "storybook": "^10.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
